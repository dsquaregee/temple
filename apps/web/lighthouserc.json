{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs",
      "startServerReadyPattern": "Serving apps/web/out",
      "url": [
        "http://localhost:4999/en/",
        "http://localhost:4999/en/temples/palani-murugan/",
        "http://localhost:4999/en/temples/brihadeeswarar/",
        "http://localhost:4999/en/yatra/arupadai-veedu/",
        "http://localhost:4999/ta/temples/thiruttani-murugan/",
        "http://localhost:4999/en/listen/"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
