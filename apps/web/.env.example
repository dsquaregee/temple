# Firebase web config for cross-device saved temples (optional).
#
# The app runs fully without these — saves fall back to on-device localStorage.
# Provide them to enable syncing saves across a devotee's devices via anonymous
# auth + Firestore. These NEXT_PUBLIC_* values are baked into the static client
# bundle; they only identify the project (access is enforced by Firestore
# rules, not secrecy). Copy to `.env.local` and fill in from the Firebase
# console (Project settings → General → Your apps → Web app → SDK config).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=temple-502523
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — defaults to <projectId>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
