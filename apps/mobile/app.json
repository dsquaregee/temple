{
  "expo": {
    "name": "Temple",
    "slug": "temple",
    "scheme": "temple",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF6EE",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dsquaregee.temple"
    },
    "android": {
      "package": "com.dsquaregee.temple",
      "adaptiveIcon": {
        "backgroundColor": "#B3411F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
