rules_version = '2';

// Temple app — Firestore holds USER STATE ONLY (visited stops, saved temples,
// preferred locale). Temple/circuit content is static and served from the CDN
// (D1), never read from Firestore. Auth starts anonymous and can be linked to
// a real account later (design: sign-in deferred until a feature needs it).
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user (anonymous or linked) may read and write only their
    // own document tree. Nobody can read anyone else's data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is denied by default (no public content in Firestore).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
